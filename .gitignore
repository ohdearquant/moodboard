# Datasets are reconstructed from manifests, never committed. See DATASETS.md.
datasets/*/images/
datasets/*/raw/
datasets/_raw/
*.zip
*.tar
*.tar.gz
*.parquet

# Manifests are LOCAL artifacts. What is committed is the recipe that builds one
# and the checksum it must produce, which carries the reproducibility claim
# without republishing anything derived from a source whose terms are restrictive
# (Unsplash) or unresolved (PACS). Regenerate with the dataset's fetch.py and
# check against checksums.sha256. See DATASETS.md, "What ready means".
datasets/*/manifest.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
.turbo/
*.tsbuildinfo

# Model caches
.cache/
~/.cache/huggingface

# Editors and OS
.DS_Store
.idea/
.vscode/

# Progress report from the implementation run. It is written before any code and overwritten
# as work proceeds, and it stays untracked: it records how the engine got built, which is not
# part of the engine.
IMPLEMENTATION_REPORT.md

# Generated by a canonical frontend-verification run. These are ignored here rather than
# excused in ADR-0009's clean-tree whitelist, because that whitelist would then be a second
# copy of this list and the two would drift. ADR-0009 requires a canonical run to start from a
# clean tracked AND untracked tree, so without these entries the run's own outputs would block
# every later invocation of the same command. `viewer/dist/` and `node_modules/` are already
# covered by the bare `dist/` and `node_modules/` patterns above; these three match nothing.
viewer/test-artifacts/
viewer/test-results/
moodboard/viewer_dist/
