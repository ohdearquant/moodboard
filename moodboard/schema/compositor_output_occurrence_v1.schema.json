{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohdearquant/moodboard/schema/compositor_output_occurrence_v1.schema.json",
  "title": "Moodboard deterministic compositor output occurrence v1",
  "description": "Closed selectable occurrence for one source-backed deterministic composite. It remains disjoint from a raw provider output occurrence.",
  "type": "object",
  "required": [
    "schema_version",
    "output_occurrence_id",
    "compositor_replay_key",
    "producer_kind",
    "role",
    "intent_packet_id",
    "original",
    "output_raster",
    "admission",
    "producer",
    "lineage"
  ],
  "properties": {
    "schema_version": { "const": "moodboard.compositor-output-occurrence.v1" },
    "output_occurrence_id": { "$ref": "#/$defs/digest" },
    "compositor_replay_key": { "$ref": "#/$defs/digest" },
    "producer_kind": { "const": "deterministic_compositor" },
    "role": { "const": "generated_image" },
    "intent_packet_id": { "$ref": "#/$defs/digest" },
    "original": {
      "$ref": "https://github.com/ohdearquant/moodboard/schema/canonical_png_v1.schema.json"
    },
    "output_raster": {
      "$ref": "https://github.com/ohdearquant/moodboard/schema/raster_srgb_u8_v1.schema.json"
    },
    "admission": { "$ref": "#/$defs/eligibleAdmission" },
    "producer": { "$ref": "#/$defs/producer" },
    "lineage": { "$ref": "#/$defs/lineage" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eligibleAdmission": {
      "type": "object",
      "required": ["state", "rejection_reasons"],
      "properties": {
        "state": { "const": "eligible" },
        "rejection_reasons": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": [
        "compositor_policy",
        "compositor_revision",
        "encoder_revision",
        "deflate_revision"
      ],
      "properties": {
        "compositor_policy": { "const": "source_backed_rect_replace.v1" },
        "compositor_revision": {
          "const": "moodboard.compositor.source-backed-rect-replace.v1"
        },
        "encoder_revision": {
          "const": "moodboard.png-encoder.rgb8-filter0-deflate-stored.v1"
        },
        "deflate_revision": {
          "const": "moodboard.deflate.rfc1951-stored-blocks.v1"
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_raster_sha256",
        "mask_sha256",
        "raw_output_occurrence_id",
        "raw_output_raster_sha256",
        "raw_structural_evidence_id",
        "raw_locality_evidence_id",
        "insert_sha256",
        "insert_compile_confirmation_id"
      ],
      "properties": {
        "source_raster_sha256": { "$ref": "#/$defs/digest" },
        "mask_sha256": { "$ref": "#/$defs/digest" },
        "raw_output_occurrence_id": { "$ref": "#/$defs/digest" },
        "raw_output_raster_sha256": { "$ref": "#/$defs/digest" },
        "raw_structural_evidence_id": { "$ref": "#/$defs/digest" },
        "raw_locality_evidence_id": { "$ref": "#/$defs/digest" },
        "insert_sha256": { "$ref": "#/$defs/digest" },
        "insert_compile_confirmation_id": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
