{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohdearquant/moodboard/schema/mask_u8_v1.schema.json",
  "title": "Moodboard canonical u8 mask descriptor v1",
  "description": "Closed descriptor for one canonical row-major binary locality mask compiled under ADR-0016. Mask bytes are stored separately and bound by mask_sha256.",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_revision",
    "width",
    "height",
    "byte_count",
    "editable_count",
    "protected_count",
    "source_raster_sha256",
    "mask_sha256"
  ],
  "properties": {
    "schema_version": { "const": "moodboard.mask.u8.v1" },
    "compiler_revision": { "$ref": "#/$defs/versionToken" },
    "width": { "$ref": "#/$defs/dimension" },
    "height": { "$ref": "#/$defs/dimension" },
    "byte_count": { "$ref": "#/$defs/safeCount" },
    "editable_count": { "$ref": "#/$defs/safePositiveCount" },
    "protected_count": { "$ref": "#/$defs/safePositiveCount" },
    "source_raster_sha256": { "$ref": "#/$defs/digest" },
    "mask_sha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "safeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "versionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
