{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohdearquant/moodboard/schema/pixel_rag_measurements_v1.schema.json",
  "title": "Moodboard Pixel RAG measured-input contract v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "evidence_status": { "const": "measured_run" } },
        "required": ["evidence_status"]
      },
      "then": { "required": ["evidence_bindings"] }
    }
  ],
  "required": [
    "descriptor",
    "evidence_status",
    "generated_at",
    "intents",
    "khive_revision",
    "schema_version",
    "source_record"
  ],
  "properties": {
    "descriptor": { "$ref": "#/$defs/descriptor" },
    "evidence_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceBinding" },
            { "properties": { "kind": { "const": "evaluation_preregistration" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceBinding" },
            { "properties": { "kind": { "const": "intent_freeze" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceBinding" },
            { "properties": { "kind": { "const": "verification_summary" } } }
          ]
        }
      ],
      "items": false
    },
    "evidence_status": { "enum": ["contract_fixture", "measured_run"] },
    "experimental_visual_embedding_diagnostics": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/experimentalVisualEmbeddingDiagnostics" }
      ]
    },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "intents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/intent" },
        { "$ref": "#/$defs/intent" }
      ],
      "items": false
    },
    "khive_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "projection": { "$ref": "#/$defs/projection" },
    "schema_version": { "const": "moodboard.pixel-rag-measurements.v1" },
    "source_record": { "$ref": "#/$defs/khiveRecord" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+-]+Z$"
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "evaluation_preregistration",
            "intent_freeze",
            "verification_summary"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "diagnosticContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation",
        "kind",
        "raw_cosine_is_probability",
        "validated_csd_or_style_probability"
      ],
      "properties": {
        "interpretation": {
          "const": "descriptive diagnostic only; no calibrated semantic or style claim"
        },
        "kind": { "const": "experimental_qwen_visual_embedding_cosine" },
        "raw_cosine_is_probability": { "const": false },
        "validated_csd_or_style_probability": { "const": false }
      }
    },
    "localOutputRegionIntentAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_apple_cosine",
        "mean_lemon_cosine",
        "mean_lemon_minus_apple_margin",
        "output_role"
      ],
      "properties": {
        "mean_apple_cosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "mean_lemon_cosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "mean_lemon_minus_apple_margin": { "type": "number", "minimum": -2, "maximum": 2 },
        "output_role": { "const": "local_output_region_diagnostic" }
      }
    },
    "restyleContentRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cosine", "output_role"],
      "properties": {
        "cosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "output_role": { "const": "external_precomputed_global_restyle" }
      }
    },
    "restyleStyleAffinity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude_centroid_cosine",
        "claude_minus_vangogh_margin",
        "claude_reference_count",
        "output_role",
        "vangogh_centroid_cosine",
        "vangogh_reference_count"
      ],
      "properties": {
        "claude_centroid_cosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "claude_minus_vangogh_margin": { "type": "number", "minimum": -2, "maximum": 2 },
        "claude_reference_count": { "const": 4 },
        "output_role": { "const": "external_precomputed_global_restyle" },
        "vangogh_centroid_cosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "vangogh_reference_count": { "const": 4 }
      }
    },
    "experimentalVisualEmbeddingDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "local_output_region_intent_alignment",
        "restyle_content_retention",
        "restyle_style_affinity"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/diagnosticContract" },
        "local_output_region_intent_alignment": {
          "$ref": "#/$defs/localOutputRegionIntentAlignment"
        },
        "restyle_content_retention": { "$ref": "#/$defs/restyleContentRetention" },
        "restyle_style_affinity": { "$ref": "#/$defs/restyleStyleAffinity" }
      }
    },
    "khiveRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_ref", "record_id"],
      "properties": {
        "content_ref": { "$ref": "#/$defs/digest" },
        "record_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "queryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_ref", "record_id", "sha256"],
      "properties": {
        "content_ref": { "$ref": "#/$defs/digest" },
        "record_id": { "$ref": "#/$defs/uuid" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_sha256",
        "dimensions",
        "fingerprint",
        "inference",
        "model_key",
        "model_name",
        "model_revision",
        "normalization",
        "pooling",
        "preprocessing",
        "prompt",
        "schema_version"
      ],
      "properties": {
        "checkpoint_sha256": { "$ref": "#/$defs/digest" },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "version"],
          "properties": {
            "provider": { "const": "lattice-embed" },
            "version": { "const": "0.9.0" }
          }
        },
        "model_key": { "type": "string", "minLength": 1 },
        "model_name": { "const": "qwen3.5-vlm-pooled-visual" },
        "model_revision": { "type": "string", "minLength": 1 },
        "normalization": { "const": "l2" },
        "pooling": { "const": "mean_visual_tokens" },
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alignment", "matte_rgb", "max_side", "resample", "revision"],
          "properties": {
            "alignment": { "const": 32 },
            "matte_rgb": { "const": [128, 128, 128] },
            "max_side": { "const": 448 },
            "resample": { "const": "lanczos3" },
            "revision": { "const": "moodboard-qwen35-srgb-pad32-max448-v1" }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "sha256"],
          "properties": {
            "revision": { "const": "moodboard-style-retrieval-v1" },
            "sha256": {
              "const": "a67ae9b539c243f498c75f1ea9f19e7018860948087728d6f8e65b34eef6a66e"
            }
          }
        },
        "schema_version": { "const": "moodboard.visual-descriptor.v1" }
      }
    },
    "legacyConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "confirmed_at", "method"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/timestamp" },
        "method": { "const": "human_confirmed" }
      }
    },
    "evidenceBoundConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_kind",
        "evidence_sha256",
        "json_pointer",
        "method"
      ],
      "properties": {
        "evidence_kind": { "const": "evaluation_preregistration" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "json_pointer": { "type": "string", "pattern": "^/" },
        "method": { "const": "evidence_bound_human_confirmation" }
      }
    },
    "confirmation": {
      "oneOf": [
        { "$ref": "#/$defs/legacyConfirmation" },
        { "$ref": "#/$defs/evidenceBoundConfirmation" }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation", "height", "kind", "label", "width", "x", "y"],
      "properties": {
        "confirmation": { "$ref": "#/$defs/confirmation" },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "kind": { "const": "normalized_rectangle" },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_ref", "rank", "record_id", "score"],
      "properties": {
        "content_ref": { "$ref": "#/$defs/digest" },
        "rank": { "type": "integer", "minimum": 1 },
        "record_id": { "$ref": "#/$defs/uuid" },
        "score": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_ref", "gain"],
      "properties": {
        "content_ref": { "$ref": "#/$defs/digest" },
        "gain": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "verificationMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "threshold", "value"],
      "oneOf": [
        { "required": ["method_revision"] },
        { "required": ["evidence_field"] }
      ],
      "properties": {
        "evidence_field": { "$ref": "#/$defs/evidenceField" },
        "id": {
          "enum": ["outside_mask_ssim", "content_retention", "intent_alignment"]
        },
        "method_revision": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["greater_than_or_equal", "less_than_or_equal"] },
        "threshold": { "type": "number", "minimum": -1, "maximum": 1 },
        "value": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "evidenceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "evidence_sha256", "json_pointer"],
      "properties": {
        "evidence_kind": { "const": "verification_summary" },
        "evidence_sha256": { "$ref": "#/$defs/digest" },
        "json_pointer": { "type": "string", "pattern": "^/" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": {
        "revision": {
          "const": "moodboard.adobe-demo-frozen-evidence-projection.v1"
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "provider", "service"],
      "properties": {
        "deterministic_postprocess": { "$ref": "#/$defs/deterministicPostprocess" },
        "execution_mode": { "const": "precomputed_external" },
        "provider": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 }
      }
    },
    "deterministicPostprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "provenance_sha256", "revision"],
      "properties": {
        "method": {
          "enum": [
            "source_backed_region_overlay",
            "restore_source_pixels_outside_confirmed_region"
          ]
        },
        "provenance_sha256": { "$ref": "#/$defs/digest" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "negativeOutputEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "evidence_id",
        "generator",
        "verification_metrics"
      ],
      "properties": {
        "disposition": { "const": "rejected" },
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$" },
        "generator": { "$ref": "#/$defs/generator" },
        "verification_metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verificationMetric" }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designer_prompt",
        "generator",
        "hits",
        "id",
        "namespace",
        "query_record",
        "region",
        "relevance_judgments",
        "verification_metrics"
      ],
      "properties": {
        "designer_prompt": { "type": "string", "minLength": 1 },
        "generator": { "$ref": "#/$defs/generator" },
        "hits": {
          "type": "array",
          "minItems": 3,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/hit" }
        },
        "id": { "enum": ["local_replace", "global_restyle"] },
        "namespace": { "type": "string", "minLength": 1 },
        "negative_output_evidence": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/negativeOutputEvidence" }
        },
        "query_record": { "$ref": "#/$defs/queryRecord" },
        "region": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/region" }
          ]
        },
        "relevance_judgments": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/judgment" }
            }
          ]
        },
        "verification_metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationMetric" }
        }
      }
    }
  }
}
