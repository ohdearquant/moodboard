{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohdearquant/moodboard/schema/raster_srgb_u8_v1.schema.json",
  "title": "Moodboard canonical sRGB u8 raster descriptor v1",
  "description": "Closed descriptor for one canonical opaque row-major RGB raster compiled under ADR-0016. Raster bytes are stored separately and bound by raster_sha256.",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_revision",
    "width",
    "height",
    "mode",
    "byte_count",
    "source_content_sha256",
    "raster_sha256"
  ],
  "properties": {
    "schema_version": { "const": "moodboard.raster.srgb-u8.v1" },
    "compiler_revision": { "$ref": "#/$defs/versionToken" },
    "width": { "$ref": "#/$defs/dimension" },
    "height": { "$ref": "#/$defs/dimension" },
    "mode": { "const": "RGB" },
    "byte_count": { "$ref": "#/$defs/safeCount" },
    "source_content_sha256": { "$ref": "#/$defs/digest" },
    "raster_sha256": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "safeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "versionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
