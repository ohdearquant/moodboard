{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohdearquant/moodboard/schema/verification_policy_v1.schema.json",
  "title": "Moodboard verification policy v1",
  "description": "Closed acceptance-gate authority for ADR-0014. V1 registers one required locality verifier.",
  "type": "object",
  "required": ["schema_version", "policy_id", "required_verifiers"],
  "properties": {
    "schema_version": { "const": "moodboard.verification-policy.v1" },
    "policy_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_verifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "moodboard.verifier.outside-mask-rgb-exact.v1" }
      ],
      "items": false
    }
  },
  "additionalProperties": false
}
